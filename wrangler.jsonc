{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "analytics-bot",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "0 */4 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
