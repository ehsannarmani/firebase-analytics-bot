# Cloudflare Workers local environment variables (.dev.vars)
BOT_TOKEN=your_telegram_bot_token_here
PROPERTY_ID=your_ga4_property_id_here
AUTHORIZED_CHATS=123456789,987654321
UPDATE_CHANNEL_ID=-100123456789
SECRET_TOKEN=your_webhook_secret_token_here

# Service Account credentials can be provided in one of the following formats:
# Format 1: Full JSON string
# SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"..."}

# Format 2: Separate email and private key
# SERVICE_ACCOUNT_CLIENT_EMAIL=xxx@yyy.iam.gserviceaccount.com
# SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Format 3: File path (Local Node.js execution only)
SERVICE_ACCOUNT_PATH=service-account/service-account.json
